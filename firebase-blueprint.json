{
  "entities": {
    "customScript": {
      "title": "Custom Script",
      "description": "A custom user-added Roblox script loader",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rawUrl": {
          "type": "string"
        },
        "emojiText": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "features": {
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "rawUrl",
        "userId"
      ]
    },
    "userConfig": {
      "title": "User Config",
      "description": "A customized game configuration for walkspeed, jump power, and other active cheats",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "gameId": {
          "type": "string"
        },
        "walkSpeed": {
          "type": "number"
        },
        "jumpPower": {
          "type": "number"
        },
        "extraToggles": {
          "type": "object"
        },
        "extraSliders": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "gameId",
        "walkSpeed",
        "jumpPower"
      ]
    },
    "supportTicket": {
      "title": "Support Ticket",
      "description": "A support request or bug report submitted by a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string"
        },
        "ownerResponse": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "email",
        "category",
        "description",
        "createdAt",
        "status"
      ]
    },
    "userSnippet": {
      "title": "User Snippet",
      "description": "A personal custom Roblox script snippet drafted by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "code"
      ]
    },
    "changelog": {
      "title": "Changelog Entry",
      "description": "An update log or change log entry specifying a database/script update",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "gameName": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["added", "fixed", "security", "database"]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "date",
        "version",
        "gameName",
        "type",
        "title",
        "description"
      ]
    }
  },
  "firestore": {
    "/custom_scripts/{scriptId}": {
      "schema": "customScript",
      "description": "Collection of user added custom game scripts"
    },
    "/user_configs/{configId}": {
      "schema": "userConfig",
      "description": "Collection of customized gameplay slider settings"
    },
    "/support_tickets/{ticketId}": {
      "schema": "supportTicket",
      "description": "Collection of bug reports and support requests"
    },
    "/user_snippets/{snippetId}": {
      "schema": "userSnippet",
      "description": "Collection of personal script snippets drafted and saved by the user"
    },
    "/changelogs/{changelogId}": {
      "schema": "changelog",
      "description": "Collection of change log logs detailing system updates and feature rollouts"
    }
  }
}
